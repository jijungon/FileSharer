# ============================================================
# FileSharer 환경변수 템플릿
#
# 사용법:  cp .env.example .env   →  .env에 실제 값 기입
# - 이 파일(.env.example)은 커밋되는 "변수 목록의 단일 소스"
# - 실제 값이 담긴 .env는 절대 커밋 금지 (.gitignore 처리됨)
# - 값은 로컬 개발(macOS 네이티브) 기준. 컨테이너 경로(/data)는
#   compose가 environment로 따로 고정 주입하므로 여기서 신경 쓸 필요 없음
# ============================================================

# --- 기본 ---
# dev/prod 분기 (쿠키 secure, 디버그 등). prod에서는 placeholder 값 검증이 켜짐
APP_ENV=dev

# 세션 서명 키. prod에서 미설정/placeholder 그대로면 기동 실패(fail-fast).
# prod용 생성 예: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-not-for-prod

# 공유 링크·원커맨드(/get) 스크립트가 절대 URL을 만들 때 사용
BASE_URL=http://localhost:8642

# --- 저장소 ---
# 파일 본체(blobs/)와 SQLite가 놓이는 곳 (로컬 개발은 ./data)
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/app.db

# --- 정책 ---
# 파일당 업로드 제한 (MB)
MAX_UPLOAD_MB=1024
# 공유 링크 만료: 기본/최대 (일)
SHARE_DEFAULT_DAYS=7
SHARE_MAX_DAYS=30
# 디스크 사용률 경고 임계치 (0.0~1.0)
DISK_WARN_RATIO=0.8

# --- 최초 관리자 부트스트랩 (users 테이블이 비어 있을 때 1회만 사용) ---
# 로컬 계정 로그인용 — 구글 로그인과 별개의 비상/테스트 경로
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Google OAuth (사내 구글 계정 로그인) ---
# GCP 콘솔 → OAuth 동의 화면(Internal) → 클라이언트 ID(웹) 생성 후 기입
# redirect URI 등록 필요: http://localhost:8642/api/auth/google/callback
# 두 값이 비어 있으면 구글 로그인 버튼이 비활성화되고 로컬 로그인만 동작
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 허용할 구글 워크스페이스 도메인 (이 도메인 계정만 로그인 가능)
ALLOWED_GOOGLE_DOMAIN=parametacorp.com
