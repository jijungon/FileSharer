#!/bin/sh
# FileSharer 원커맨드 받기 — 의존성: curl, tar, sh (alpine/미니멀 VM 호환)
# 사용: curl -fsSL <url>/get | sh [-s -- -C <대상디렉토리>]
# 비밀번호 링크: 아래 중 하나
#   1) 그냥 실행하면 비밀번호를 물어봄:  curl -fsSL <url>/get | sh
#   2) 환경변수로 전달(파이프 오른쪽!):  curl -fsSL <url>/get | SHARE_PW=<pw> sh
set -eu

BASE="__BASE__"
TOKEN="__TOKEN__"
TYPE="__TYPE__"
NAME="__NAME__"
SHA="__SHA256__"
PROTECTED="__PROTECTED__"

DEST="."
while [ $# -gt 0 ]; do
  case "$1" in
    -C) DEST="$2"; shift 2 ;;
    *) echo "usage: curl -fsSL .../get | sh -s -- [-C dir]" >&2; exit 2 ;;
  esac
done

# 비밀번호 링크인데 SHARE_PW가 없으면 터미널에서 물어본다 (파이프 실행에서도 /dev/tty로 입력).
if [ "$PROTECTED" = "1" ] && [ -z "${SHARE_PW:-}" ]; then
  if [ -r /dev/tty ]; then
    printf '비밀번호: ' > /dev/tty
    stty -echo < /dev/tty 2>/dev/null || true
    read -r SHARE_PW < /dev/tty
    stty echo < /dev/tty 2>/dev/null || true
    printf '\n' > /dev/tty
  else
    echo "이 링크는 비밀번호가 필요합니다. 예: curl -fsSL .../get | SHARE_PW=<pw> sh" >&2
    exit 3
  fi
fi

AUTH=""
[ -n "${SHARE_PW:-}" ] && AUTH=":${SHARE_PW}"

fetch() { # $1: 경로(tar|download), $2...: curl 추가 인자
  path="$1"; shift
  if [ -n "$AUTH" ]; then
    curl -fsSL -u "$AUTH" "$@" "$BASE/s/$TOKEN/$path"
  else
    curl -fsSL "$@" "$BASE/s/$TOKEN/$path"
  fi
}

mkdir -p "$DEST"

if [ "$TYPE" = "folder" ]; then
  echo "-> ${NAME}/ (tar.gz stream)"
  fetch tar | tar xzf - -C "$DEST"
  echo "ok: $DEST/$NAME"
else
  echo "-> $NAME"
  fetch download -o "$DEST/$NAME"
  if [ -n "$SHA" ]; then
    if command -v sha256sum >/dev/null 2>&1; then
      echo "$SHA  $DEST/$NAME" | sha256sum -c - >/dev/null && echo "ok: sha256"
    elif command -v shasum >/dev/null 2>&1; then
      echo "$SHA  $DEST/$NAME" | shasum -a 256 -c - >/dev/null && echo "ok: sha256"
    fi
  fi
  echo "ok: $DEST/$NAME"
fi
